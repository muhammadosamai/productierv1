# Vite / SPA (copy to `.env.production` or set in CI for `vite build`)
# =============================================================================
# Public origin of the site (no trailing slash, no /api).
#
# Example: SPA at https://productier.wonderbyte.io/ and API at https://productier.wonderbyte.io/api/
# Same host: relative /uploads/* already targets this host; set VITE_API_ORIGIN anyway if you want
# absolute URLs for avatars/logos (e.g. odd caching or base-tag setups).
# =============================================================================
VITE_API_ORIGIN=https://productier.wonderbyte.io
