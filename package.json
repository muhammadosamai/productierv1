{
  "name": "productierv1",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && bun run dev",
    "dev:all": "run-p dev dev:server",
    "lint": "npm run type-check && npm run lint:frontend && npm run check:no-hardcoded-api",
    "lint:frontend": "eslint \"src/**/*.{ts,vue}\" --max-warnings=0",
    "test": "vitest run --config vitest.config.ts --passWithNoTests",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "check:no-hardcoded-api": "node ./scripts/check-no-hardcoded-api.mjs",
    "db:push": "cd server && bun run db:push",
    "db:seed": "cd server && bun run db:seed",
    "db:seed:full": "cd server && bun run db:seed:full",
    "db:seed:endpoint-test": "cd server && bun run db:seed:endpoint-test",
    "db:bootstrap:full": "cd server && bun run db:push && bun run db:seed:full",
    "db:studio": "cd server && bun run db:studio",
    "endpoint:test": "bun --env-file=.env.endpoint-tests \"Endpoint Docs/run-endpoint-tests.ts\"",
    "endpoint:test:permissions": "bun --env-file=.env.endpoint-tests \"Endpoint Docs/run-permission-matrix.ts\"",
    "endpoint:check:scalability": "bun --env-file=.env.endpoint-tests \"Endpoint Docs/check-scalability-rollout.ts\"",
    "endpoint:test:scalability": "bun --env-file=.env.endpoint-tests \"Endpoint Docs/run-endpoint-tests.ts\" && bun --env-file=.env.endpoint-tests \"Endpoint Docs/check-scalability-rollout.ts\""
  },
  "dependencies": {
    "@internationalized/date": "^3.12.0",
    "@tiptap/extension-link": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/extension-underline": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/vue-3": "^3.20.1",
    "@vueuse/core": "^14.2.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.3.3",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.1",
    "pinia": "^3.0.4",
    "reka-ui": "^2.9.0",
    "tailwind-merge": "^3.5.0",
    "vue": "^3.5.29",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^5.0.3",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@tsconfig/node24": "^24.0.4",
    "@types/node": "^24.11.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.1.0",
    "eslint-plugin-vue": "^10.8.0",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.1.2",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
