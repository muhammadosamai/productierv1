# ========================
# Productier server secrets
# ========================
# Non-secret operational settings moved to:
# - server/config/runtime.public.yaml
# - server/config/runtime.public.example.yaml

# ========================
# Core secret runtime
# ========================
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/productier

# ========================
# JWT private signing key (secret)
# ========================
# Provide ONE source:
# JWT_PRIVATE_KEY_PATH=./keys/jwt-2026-03-private.pem
# JWT_PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ========================
# Semantic search API credentials (secret)
# ========================
# Required when SEARCH_EMBEDDING_PROVIDER=openai and semantic search is enabled.
# SEARCH_EMBEDDING_API_KEY=sk-...

# Optional dedicated Home Daily Brief provider key (secret).
# Falls back to SEARCH_EMBEDDING_API_KEY when unset.
# HOME_DAILY_BRIEF_API_KEY=sk-...

# ========================
# Integrations credentials encryption (secret)
# ========================
# Required outside test mode.
# INTEGRATIONS_SECRET_KEY=replace-with-dedicated-encryption-key

# ========================
# Optional notifications channel webhooks (secret)
# ========================
# NOTIFICATIONS_EMAIL_WEBHOOK_URL=https://example.com/hooks/notifications-email
# NOTIFICATIONS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ========================
# Demo seed script credentials (secret, non-production runtime)
# ========================
SEED_DEMO_PASSWORD=change-me-local
# Optional dedicated password for endpoint-test seed users.
# Falls back to SEED_DEMO_PASSWORD when not provided.
# SEED_ENDPOINT_TEST_PASSWORD=change-me-local

