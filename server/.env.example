# Productier server secrets only.
# ========================
# Core secret runtime
# ========================
DATABASE_URL=postgresql://user@localhost:5432/productier
# ========================
# JWT private signing key (secret)
# ========================
# JWT_PRIVATE_KEY_PATH=./keys/jwt-private.pem
# JWT_PRIVATE_KEY_PEM=<base64-encoded PEM>
# ========================
# SendGrid email (secret)
# ========================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@productier.com
APP_URL=http://localhost:5173
# ========================
# CORS (browser → API when origins differ)
# ========================
# Comma-separated. Override entirely with CORS_ORIGIN=... If unset, allows localhost:5173 and
# https://productier.wonderbyte.io (same host as API path /api is still same-origin for the SPA).
# CORS_ORIGIN=http://localhost:5173,https://productier.wonderbyte.io
# ========================
# Reverse proxy
# ========================
# Route both /api/* and /uploads/* to this server (avatars, logos, attachments), not only /api.
# ========================
# Optional
# ========================
SEED_DEMO_PASSWORD=change-me-local
